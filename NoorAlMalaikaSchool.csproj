    <VSToolsPath Condition="'$(VSToolsPath)'=='' And Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v17.0')">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v17.0</VSToolsPath>
