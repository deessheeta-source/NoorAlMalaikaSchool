<?xml version="1.0" encoding="utf-8"?>

<!-- Debug-only transform.

     Web.config itself now carries the SAFE settings (debug="false", customErrors On,
     errorMode Custom). This file relaxes them for local debugging only, and it is applied
     when you build/publish with Configuration=Debug.

     Nothing here should ever reach a real deployment: Web.Release.config is the transform
     that matters for production, and it forces requireSSL="true" on the cookies and on the
     forms-auth ticket. -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<system.web>
		<!-- Recompile on change and show full exception details while debugging locally. -->
		<compilation debug="true" xdt:Transform="SetAttributes(debug)" />

		<customErrors mode="Off" xdt:Transform="Replace" />
	</system.web>

	<system.webServer>
		<!-- Detailed IIS errors for the developer, still not for remote callers. -->
		<httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough"
			xdt:Transform="SetAttributes(errorMode, existingResponse)" />
	</system.webServer>

</configuration>
