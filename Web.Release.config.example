<?xml version="1.0" encoding="utf-8"?>

<!-- ================================================================
     Web.Release.config.example — قالب بيئة الإنتاج
     ================================================================
     هذا الملف قالب للمطوّرين الجدد.
     انسخه إلى Web.Release.config وعدّل القيم قبل النشر.

     ⚠️ Web.Release.config يجب أن يبقى خارج Git (.gitignore).
        لا ترفع مفاتيح machineKey الحقيقية إلى الـ repository.

     لتوليد مفاتيح جديدة، شغّل:
       Tools\Generate-MachineKey.ps1
     ================================================================ -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<connectionStrings>
		<add name="DefaultConnection"
			connectionString="Server=YOUR_PRODUCTION_SERVER\SQLSERVER;Database=NoorAlMalaikaSchool;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
			xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)" />
	</connectionStrings>

	<appSettings>
		<!-- الإنتاج يعمل على HTTPS فقط: فعّل إعادة التوجيه و HSTS في وقت التشغيل.
		     لا تفعّل هذه القيم قبل وجود ربط HTTPS بشهادة مطابقة لاسم النطاق. -->
		<add key="EnableHttpsRedirect" value="true" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
		<add key="EnableHsts" value="true" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
	</appSettings>

	<system.web>
		<!--
		  machineKey لم يعد داخل Web.config. المفتاح الفعلي لكل بيئة يُقرأ من
		  Config\machineKey.config (غير مُتتبَّع في Git). ولّده بـ:
		      Database\tools\Generate-MachineKey.ps1 -WriteTo Config\machineKey.config
		-->
		<compilation xdt:Transform="RemoveAttributes(debug)" />

		<httpCookies httpOnlyCookies="true" requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" xdt:Locator="Match(httpOnlyCookies)" />

		<authentication mode="Forms">
			<forms
			  loginUrl="~/Login.aspx"
			  timeout="60"
			  defaultUrl="~/Default.aspx"
			  requireSSL="true"
			  slidingExpiration="true"
			  xdt:Transform="SetAttributes(requireSSL)" xdt:Locator="Match(loginUrl)" />
		</authentication>

		<customErrors mode="On" defaultRedirect="~/Error.aspx" xdt:Transform="Replace">
			<error statusCode="500" redirect="~/Error.aspx" />
			<error statusCode="404" redirect="~/Error.aspx" />
		</customErrors>
	</system.web>

	<system.webServer>
		<!-- الترويسات الأساسية (nosniff / X-Frame-Options / Referrer-Policy)
		     أصبحت في Web.config. HSTS يُضاف وقت التشغيل عند EnableHsts=true. -->
	</system.webServer>

</configuration>
