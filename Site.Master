<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="NoorAlMalaikaSchool.SiteMaster" %>

<!DOCTYPE html>

<html dir="rtl" lang="ar">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>مدرسة نور الملائكة</title>

    <link href="<%= ResolveUrl("~/Content/fonts/droid-arabic-kufi/DroidKufi.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/css/bootstrap.rtl.min.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/css/Site_Master.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/fonts/fontawesome-free/css/all.min.css") %>"
          rel="stylesheet" />

    <style>
        /* =========================================================
           SIDEBAR — Flyout Design (RTL)
           ========================================================= */
        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: 275px;
            height: 100vh;
            background: #ffffff;
            border-left: 1px solid #e9ecef;
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: transform 0.3s ease;
        }

        /* ---------- Brand ---------- */
        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px 20px;
            border-bottom: 1px solid #eef1f3;
        }
        .sidebar-brand .brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #00b14f 0%, #4ed17e 100%);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 10px rgba(0,177,79,0.25);
        }
        .sidebar-brand .brand-text {
            font-size: 15px;
            font-weight: 800;
            color: #212529;
            line-height: 1.2;
        }
        .sidebar-brand .brand-sub {
            font-size: 10.5px;
            color: #868e96;
            font-weight: 500;
        }

        /* ---------- Stage selector ---------- */
        .stage-selector {
            padding: 14px 20px 16px;
            border-bottom: 1px solid #eef1f3;
            background: linear-gradient(180deg, #ffffff 0%, #fbfdfc 100%);
        }
        .stage-selector label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            color: #6c757d;
            margin-bottom: 6px;
        }
        .stage-selector .form-select {
            font-size: 13px;
            font-weight: 600;
            padding: 8px 12px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background-color: #f9fafb;
            color: #00b14f;
            cursor: pointer;
        }
        .stage-selector .form-select:focus {
            border-color: #00b14f;
            box-shadow: 0 0 0 3px rgba(0,177,79,0.12);
        }

        /* ---------- Nav container ---------- */
        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 0;
        }
        .sidebar-nav::-webkit-scrollbar { width: 6px; }
        .sidebar-nav::-webkit-scrollbar-thumb {
            background: rgba(0,177,79,0.2);
            border-radius: 3px;
        }
        .sidebar-nav::-webkit-scrollbar-thumb:hover {
            background: rgba(0,177,79,0.35);
        }

        .nav-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .nav-item {
            position: relative;
        }

        /* ---------- Top-level link ---------- */
        .nav-item > .nav-link-parent {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: #495057;
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
            border-right: 3px solid transparent;
        }
        .nav-item > .nav-link-parent:hover {
            background: rgba(0,177,79,0.06);
            color: #00b14f;
            text-decoration: none;
        }
        .nav-item.section-active > .nav-link-parent {
            background: rgba(0,177,79,0.09);
            color: #00b14f;
            border-right-color: #00b14f;
        }

        .nav-icon {
            width: 20px;
            text-align: center;
            font-size: 15px;
            color: #00b14f;
            flex-shrink: 0;
        }

        .nav-chevron {
            margin-right: auto;
            font-size: 10px;
            color: #adb5bd;
            transition: transform 0.2s ease, color 0.2s ease;
        }
        .nav-item:hover .nav-chevron {
            transform: translateX(-3px);
            color: #00b14f;
        }

        /* =========================================================
           FLYOUT — fixed positioning (RTL)
           ========================================================= */
        .nav-flyout {
            position: fixed;
            top: 0;
            right: 0;
            padding: 8px;
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 14px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.14);
            list-style: none;
            margin: 0;

            opacity: 0;
            visibility: hidden;
            transform: translateX(10px);
            transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;

            z-index: 9999;
            pointer-events: none;
        }

        .nav-flyout.flyout-open {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
            pointer-events: auto;
        }

        /* Arrow */
        .nav-flyout::before {
            content: '';
            position: absolute;
            right: -7px;
            top: 18px;
            width: 12px;
            height: 12px;
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-left: none;
            border-bottom: none;
            transform: rotate(45deg);
        }

        .nav-flyout li { list-style: none; }

        .nav-flyout li a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            color: #495057;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.15s ease;
            white-space: nowrap;
            border: 1px solid rgba(5, 132, 7, 0.4);
            background: rgba(0, 177, 79, 0.02);
        }
        .nav-flyout li a:hover {
            background: rgba(0,177,79,0.08);
            color: #00b14f;
            text-decoration: none;
        }
        .nav-flyout li a.active {
            background: rgba(0,177,79,0.13);
            color: #00b14f;
            font-weight: 700;
        }
        .nav-flyout li a i {
            font-size: 13px;
            width: 18px;
            text-align: center;
            color: #00b14f;
            flex-shrink: 0;
        }

        /* =========================================================
           Sidebar Overlay (mobile)
           ========================================================= */
        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,0.5);
            backdrop-filter: blur(2px);
            z-index: 99;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }
        .sidebar-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        /* =========================================================
           Main content offset (RTL)
           ========================================================= */
        .main-content {
            margin-right: 268px;
        }

        /* =========================================================
           Mobile (<= 991px)
           ========================================================= */
        @media (max-width: 991px) {
            .sidebar {
                transform: translateX(100%);
            }
            .sidebar.show {
                transform: translateX(0);
                box-shadow: -8px 0 24px rgba(0,0,0,0.15);
            }

            .main-content {
                margin-right: 0;
            }

            /* Flyout → Accordion inline */
            .nav-flyout {
                position: static;
                min-width: 0;
                width: auto;
                padding: 4px 8px 8px;
                margin: 0 12px 6px;
                border: none;
                box-shadow: none;
                background: rgba(0,177,79,0.04);
                border-radius: 10px;
                opacity: 1;
                visibility: visible;
                transform: none;
                display: none;
                pointer-events: auto;
            }
            .nav-flyout.flyout-open {
                display: block;
            }
            .nav-flyout::before { display: none; }

            .nav-item.open .nav-chevron {
                transform: rotate(-90deg);
                color: #00b14f;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent"
                            runat="server" />

    <style>
        /* جداول السجلات تتحول إلى بطاقات على الهاتف فقط */
        @media (max-width: 767.98px) {
            .mobile-card-table-wrap,
            .mobile-card-table-container {
                overflow-x: visible !important;
                overflow-y: visible !important;
                max-width: 100% !important;
            }

            table[data-mobile-card-table="true"] {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                table-layout: auto !important;
                border-collapse: separate !important;
                border-spacing: 0 !important;
            }
            table[data-mobile-card-table="true"] > thead,
            table[data-mobile-card-table="true"] > colgroup,
            table[data-mobile-card-table="true"] > tbody > tr.mobile-card-table-header {
                display: none !important;
            }
            table[data-mobile-card-table="true"] > tbody,
            table[data-mobile-card-table="true"] > tfoot {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr,
            table[data-mobile-card-table="true"] > tfoot > tr {
                display: block !important;
                box-sizing: border-box !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 0 12px !important;
                padding: 10px 14px !important;
                border: 1px solid #e5eee9 !important;
                border-radius: 14px !important;
                background: #fff !important;
                box-shadow: 0 4px 14px rgba(31, 61, 51, 0.06) !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td,
            table[data-mobile-card-table="true"] > tfoot > tr > td {
                display: grid !important;
                grid-template-columns: minmax(72px, 28%) minmax(0, 1fr) !important;
                align-items: start !important;
                gap: 8px !important;
                box-sizing: border-box !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 8px 0 !important;
                border: 0 !important;
                border-bottom: 1px solid #f1f3f5 !important;
                background: transparent !important;
                text-align: right !important;
                white-space: normal !important;
                overflow-wrap: anywhere !important;
                word-break: break-word !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td[data-label]::before,
            table[data-mobile-card-table="true"] > tfoot > tr > td[data-label]::before {
                content: attr(data-label);
                display: block;
                color: #6c757d;
                font-size: 11px;
                font-weight: 800;
                line-height: 1.6;
                text-align: right;
                overflow-wrap: anywhere;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td[colspan],
            table[data-mobile-card-table="true"] > tfoot > tr > td[colspan] {
                display: block !important;
                border-bottom: 0 !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td[colspan]::before,
            table[data-mobile-card-table="true"] > tfoot > tr > td[colspan]::before {
                display: none !important;
                content: none !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td:last-child,
            table[data-mobile-card-table="true"] > tfoot > tr > td:last-child {
                border-bottom: 0 !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr {
                display: flex !important;
                flex-direction: column !important;
                gap: 4px !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr > th,
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr > td {
                display: block !important;
                box-sizing: border-box !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 3px 0 !important;
                border: 0 !important;
                background: transparent !important;
                text-align: right !important;
                white-space: normal !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.net {
                background: linear-gradient(90deg, rgba(0,177,79,0.08), rgba(0,177,79,0.04)) !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.remaining {
                background: linear-gradient(90deg, rgba(220,53,69,0.06), rgba(220,53,69,0.02)) !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.net > th,
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.net > td {
                color: #007a33 !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.remaining > th,
            table[data-mobile-card-table="true"][data-mobile-card-layout="key-value"] > tbody > tr.remaining > td {
                color: #a51c1c !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="field-grid"] {
                border: 0 !important;
                border-radius: 0 !important;
                overflow: visible !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="field-grid"] > tbody {
                display: grid !important;
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 10px !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="field-grid"] > tbody > tr {
                display: grid !important;
                grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)) !important;
                gap: 10px !important;
                margin: 0 0 10px !important;
                padding: 0 !important;
                border: 0 !important;
                border-radius: 0 !important;
                background: transparent !important;
                box-shadow: none !important;
            }
            table[data-mobile-card-table="true"][data-mobile-card-layout="field-grid"] > tbody > tr > td {
                display: block !important;
                box-sizing: border-box !important;
                width: auto !important;
                max-width: 100% !important;
                padding: 10px !important;
                border: 1px solid #e5eee9 !important;
                border-radius: 12px !important;
                background: #fff !important;
                box-shadow: 0 3px 10px rgba(31, 61, 51, 0.05) !important;
                overflow-wrap: anywhere !important;
            }
            table[data-mobile-card-table="true"] > tbody > tr > td > *,
            table[data-mobile-card-table="true"] > tfoot > tr > td > * {
                box-sizing: border-box;
                min-width: 0 !important;
                max-width: 100% !important;
                overflow-wrap: anywhere;
            }
            table[data-mobile-card-table="true"] input:not([type="checkbox"]):not([type="radio"]),
            table[data-mobile-card-table="true"] select,
            table[data-mobile-card-table="true"] textarea {
                box-sizing: border-box !important;
                min-width: 0 !important;
                max-width: 100% !important;
            }
            table[data-mobile-card-table="true"] button,
            table[data-mobile-card-table="true"] .btn {
                max-width: 100% !important;
                white-space: normal !important;
                overflow-wrap: anywhere !important;
            }
        }
    </style>

</head>

<body>

<form id="form1"
      runat="server">

    <asp:ScriptManager ID="ScriptManager1"
                       runat="server"
                       EnablePartialRendering="true" />

    <!-- ===================================================== -->
    <!-- Sidebar -->
    <!-- ===================================================== -->

    <aside class="sidebar"
           id="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div>
                <div class="brand-text">نور الملائكة</div>
                <div class="brand-sub">Noor Al Malaika School</div>
            </div>
        </div>

        <!-- Stage -->
        <div class="stage-selector">
            <label>المستوى الدراسي</label>
            <asp:DropDownList
                ID="ddlStage"
                runat="server"
                CssClass="form-select"
                AutoPostBack="true"
                OnSelectedIndexChanged="ddlStage_SelectedIndexChanged">
                <asp:ListItem Text="المرحلة الأساسية" Value="Basic" />
                <asp:ListItem Text="المرحلة الثانوية" Value="Secondary" />
            </asp:DropDownList>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">

            <ul class="nav-list">

                <!-- =========================================== -->
                <!-- 1) لوحة التحكم — رابط مباشر -->
                <!-- =========================================== -->
                <li id="navMain" runat="server"
                    class='nav-item <%= GetActiveClass("Default.aspx") %>'>
                    <a href='<%= GetStageUrl("Default.aspx") %>'
                       class="nav-link-parent">
                        <i class="nav-icon fas fa-th-large"></i>
                        <span>لوحة التحكم</span>
                    </a>
                </li>

                <li id="navWhatsApp" runat="server" class='nav-item <%= GetActiveClass("WhatsApp") %>'>
                    <a href='<%= GetStageUrl("WhatsApp/Default.aspx") %>' class="nav-link-parent">
                        <i class="nav-icon fab fa-whatsapp"></i>
                        <span>واتساب</span>
                    </a>
                </li>

                <!-- =========================================== -->
                <!-- 2) الشؤون الإدارية للطلاب -->
                <!-- =========================================== -->
                <li id="navStudents" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("Students","Attendance","StudentList","AttendanceReport") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-user-graduate"></i>
                        <span>الشؤون الإدارية للطلاب</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li id="liStudentsManagement" runat="server">
                            <a href='<%= GetStageUrl("Students/Default.aspx") %>'
                               class='<%= GetActiveClass("Students") %>'>
                                <i class="fas fa-user-graduate"></i>
                                إدارة بيانات الطلاب
                            </a>
                        </li>
                        <li id="liAttendanceManagement" runat="server">
                            <a href='<%= GetStageUrl("Attendance/Default.aspx") %>'
                               class='<%= GetActiveClass("Attendance") %>'>
                                <i class="fas fa-clipboard-check"></i>
                                إدارة الحضور والغياب
                            </a>
                        </li>
                        <li id="liStudentListReport" runat="server">
                            <a href='<%= GetStageUrl("Reports/StudentList.aspx") %>'
                               class='<%= GetActiveClass("StudentList") %>'>
                                <i class="fas fa-chart-bar"></i>
                                تقرير بيانات الطلاب
                            </a>
                        </li>
                        <li id="liAttendanceReport" runat="server">
                            <a href='<%= GetStageUrl("Reports/AttendanceReport.aspx") %>'
                               class='<%= GetActiveClass("AttendanceReport") %>'>
                                <i class="fas fa-user-check"></i>
                                تقرير الحضور والغياب
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 3) الشؤون المالية للطلاب -->
                <!-- =========================================== -->
                <li id="navFinance" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("StudentFinances","Fees","Invoices","DiscountPolicies") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-wallet"></i>
                        <span>الشؤون المالية للطلاب</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a href='<%= GetStageUrl("Fees/StudentFinances.aspx") %>'
                               class='<%= GetActiveClass("StudentFinances") %>'>
                                <i class="fas fa-user-tag"></i>
                                رسوم اشتراك الطلاب
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Fees/Default.aspx") %>'
                               class='<%= GetActiveClass("Fees") %>'>
                                <i class="fas fa-money-bill-wave"></i>
                                إدارة رسوم الاشتراك
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Invoices/Default.aspx") %>'
                               class='<%= GetActiveClass("Invoices") %>'>
                                <i class="fas fa-file-invoice"></i>
                                إدارة الفواتير المالية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("DiscountPolicies/Default.aspx") %>'
                               class='<%= GetActiveClass("DiscountPolicies") %>'>
                                <i class="fas fa-percent"></i>
                                إدارة الخصومات المالية
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 4) الشؤون الأكاديمية -->
                <!-- =========================================== -->
                <li id="navAcademic" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("Classes","Subjects","Timetable","MonthlySheets") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-book-open"></i>
                        <span>الشؤون الأكاديمية</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a href='<%= GetStageUrl("Classes/Default.aspx") %>'
                               class='<%= GetActiveClass("Classes") %>'>
                                <i class="fas fa-chalkboard"></i>
                                إدارة الصفوف الدراسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Subjects/Default.aspx") %>'
                               class='<%= GetActiveClass("Subjects") %>'>
                                <i class="fas fa-book-open"></i>
                                إدارة المواد الدراسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Timetable/Default.aspx") %>'
                               class='<%= GetActiveClass("Timetable") %>'>
                                <i class="fas fa-calendar-alt"></i>
                                إدارة الجدول المدرسي
                            </a>
                        </li>
                         <!-- عرض الجداول: للمستخدم View -->
                        <li id="liSchoolTimetable" runat="server">
                            <a href="<%= ResolveUrl("~/Pages/Timetable/SchoolTimetable.aspx") %>">
                                <i class="fas fa-calendar-check"></i>
                                عرض الجداول المدرسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("MonthlySheets/Default.aspx") %>'
                               class='<%= GetActiveClass("MonthlySheets") %>'>
                                <i class="fas fa-file-alt"></i>
                                إدارة الصحيفة الشهرية
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 5) شؤون المعلمين والمعلمات -->
                <!-- =========================================== -->
                <li id="navTeachers" runat="server" class="nav-item has-flyout">
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-chalkboard-teacher"></i>
