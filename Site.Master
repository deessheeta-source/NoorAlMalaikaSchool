<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="NoorAlMalaikaSchool.SiteMaster" %>

<!DOCTYPE html>

<html dir="rtl" lang="ar">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>مدرسة نور الملائكة</title>

    <link href="<%= ResolveUrl("~/Content/fonts/droid-arabic-kufi/DroidKufi.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/css/bootstrap.rtl.min.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/css/Site_Master.css") %>"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/Content/fonts/fontawesome-free/css/all.min.css") %>"
          rel="stylesheet" />

    <!-- Layout rules live in Content/css/site-master-layout.css -->
    <link href="<%= ResolveUrl("~/Content/css/site-master-layout.css") %>"
          rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent"
                            runat="server" />


</head>

<body>

<form id="form1"
      runat="server">

    <asp:ScriptManager ID="ScriptManager1"
                       runat="server"
                       EnablePartialRendering="true" />

    <!-- ===================================================== -->
    <!-- Sidebar -->
    <!-- ===================================================== -->

    <aside class="sidebar"
           id="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div>
                <div class="brand-text">نور الملائكة</div>
                <div class="brand-sub">Noor Al Malaika School</div>
            </div>
        </div>

        <!-- Stage -->
        <div class="stage-selector">
            <label>المستوى الدراسي</label>
            <asp:DropDownList
                ID="ddlStage"
                runat="server"
                CssClass="form-select"
                AutoPostBack="true"
                OnSelectedIndexChanged="ddlStage_SelectedIndexChanged">
                <asp:ListItem Text="المرحلة الأساسية" Value="Basic" />
                <asp:ListItem Text="المرحلة الثانوية" Value="Secondary" />
            </asp:DropDownList>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">

            <ul class="nav-list">

                <!-- =========================================== -->
                <!-- 1) لوحة التحكم — رابط مباشر -->
                <!-- =========================================== -->
                <li id="navMain" runat="server"
                    class='nav-item <%= GetActiveClass("Default.aspx") %>'>
                    <a href='<%= GetStageUrl("Default.aspx") %>'
                       class="nav-link-parent">
                        <i class="nav-icon fas fa-th-large"></i>
                        <span>لوحة التحكم</span>
                    </a>
                </li>

                <li id="navWhatsApp" runat="server" class='nav-item <%= GetActiveClass("WhatsApp") %>'>
                    <a href='<%= GetStageUrl("WhatsApp/Default.aspx") %>' class="nav-link-parent">
                        <i class="nav-icon fab fa-whatsapp"></i>
                        <span>واتساب</span>
                    </a>
                </li>

                <!-- =========================================== -->
                <!-- 2) الشؤون الإدارية للطلاب -->
                <!-- =========================================== -->
                <li id="navStudents" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("Students","Attendance","StudentList","AttendanceReport") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-user-graduate"></i>
                        <span>الشؤون الإدارية للطلاب</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li id="liStudentsManagement" runat="server">
                            <a href='<%= GetStageUrl("Students/Default.aspx") %>'
                               class='<%= GetActiveClass("Students") %>'>
                                <i class="fas fa-user-graduate"></i>
                                إدارة بيانات الطلاب
                            </a>
                        </li>
                        <li id="liAttendanceManagement" runat="server">
                            <a href='<%= GetStageUrl("Attendance/Default.aspx") %>'
                               class='<%= GetActiveClass("Attendance") %>'>
                                <i class="fas fa-clipboard-check"></i>
                                إدارة الحضور والغياب
                            </a>
                        </li>
                        <li id="liStudentListReport" runat="server">
                            <a href='<%= GetStageUrl("Reports/StudentList.aspx") %>'
                               class='<%= GetActiveClass("StudentList") %>'>
                                <i class="fas fa-chart-bar"></i>
                                تقرير بيانات الطلاب
                            </a>
                        </li>
                        <li id="liAttendanceReport" runat="server">
                            <a href='<%= GetStageUrl("Reports/AttendanceReport.aspx") %>'
                               class='<%= GetActiveClass("AttendanceReport") %>'>
                                <i class="fas fa-user-check"></i>
                                تقرير الحضور والغياب
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 3) الشؤون المالية للطلاب -->
                <!-- =========================================== -->
                <li id="navFinance" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("StudentFinances","Fees","Invoices","DiscountPolicies") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-wallet"></i>
                        <span>الشؤون المالية للطلاب</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a href='<%= GetStageUrl("Fees/StudentFinances.aspx") %>'
                               class='<%= GetActiveClass("StudentFinances") %>'>
                                <i class="fas fa-user-tag"></i>
                                رسوم اشتراك الطلاب
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Fees/Default.aspx") %>'
                               class='<%= GetActiveClass("Fees") %>'>
                                <i class="fas fa-money-bill-wave"></i>
                                إدارة رسوم الاشتراك
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Invoices/Default.aspx") %>'
                               class='<%= GetActiveClass("Invoices") %>'>
                                <i class="fas fa-file-invoice"></i>
                                إدارة الفواتير المالية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("DiscountPolicies/Default.aspx") %>'
                               class='<%= GetActiveClass("DiscountPolicies") %>'>
                                <i class="fas fa-percent"></i>
                                إدارة الخصومات المالية
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 4) الشؤون الأكاديمية -->
                <!-- =========================================== -->
                <li id="navAcademic" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("Classes","Subjects","Timetable","MonthlySheets") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-book-open"></i>
                        <span>الشؤون الأكاديمية</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a href='<%= GetStageUrl("Classes/Default.aspx") %>'
                               class='<%= GetActiveClass("Classes") %>'>
                                <i class="fas fa-chalkboard"></i>
                                إدارة الصفوف الدراسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Subjects/Default.aspx") %>'
                               class='<%= GetActiveClass("Subjects") %>'>
                                <i class="fas fa-book-open"></i>
                                إدارة المواد الدراسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Timetable/Default.aspx") %>'
                               class='<%= GetActiveClass("Timetable") %>'>
                                <i class="fas fa-calendar-alt"></i>
                                إدارة الجدول المدرسي
                            </a>
                        </li>
                         <!-- عرض الجداول: للمستخدم View -->
                        <li id="liSchoolTimetable" runat="server">
                            <a href="<%= ResolveUrl("~/Pages/Timetable/SchoolTimetable.aspx") %>">
                                <i class="fas fa-calendar-check"></i>
                                عرض الجداول المدرسية
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("MonthlySheets/Default.aspx") %>'
                               class='<%= GetActiveClass("MonthlySheets") %>'>
                                <i class="fas fa-file-alt"></i>
                                إدارة الصحيفة الشهرية
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 5) شؤون المعلمين والمعلمات -->
                <!-- =========================================== -->
                <li id="navTeachers" runat="server" class="nav-item has-flyout">
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-chalkboard-teacher"></i>
                        <span>شؤون المعلمين والمعلمات</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li id="liTeachersDefault" runat="server">
                            <a id="lnkTeachersDefault" runat="server" class=""></a>
                        </li>

                        <li id="liAttendanceHome" runat="server">
                            <a id="lnkAttendanceHome" runat="server" class=""></a>
                        </li>

                        <!-- ⭐ رابط: المعلمون الدائمون والمشرفون -->
                        <li id="liPermanentStaff" runat="server">
                            <a id="lnkPermanentStaff" runat="server" class=""></a>
                        </li>

                        <li id="liMyRecords" runat="server">
                            <a id="lnkMyRecords" runat="server" class=""></a>
                        </li>
                        <!-- الشؤون المالية للمعلمين -->
                        <li id="liTeachersFinances" runat="server">
                            <a id="lnkTeachersFinances" runat="server" class=""></a>
                        </li>

                        <!-- كشف استحقاقات المعلمين - للعرض فقط -->
                        <li id="liTeachersFinancesView" runat="server">
                            <a id="lnkTeachersFinancesView" runat="server" class=""></a>
                        </li>
                        <li id="liTeacherReport" runat="server">
                            <a id="lnkTeacherReport" runat="server" class=""></a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 6) التقارير العامة -->
                <!-- =========================================== -->
                <li id="navReports" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("FinancialReport","StudentFinancialTotals","StudentFinancialStatement") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-chart-pie"></i>
                        <span>التقارير العامة</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a id="lnkFinancialReport"
                               runat="server"
                               class='<%= GetActiveClass("FinancialReport") %>'>
                                <i class="fas fa-chart-line"></i>
                                التقرير المالي للطلاب
                            </a>
                        </li>

                        <!-- ⭐ جديد: التقرير المالي الإجمالي للطلاب -->
                        <li id="liStudentFinancialTotals" runat="server">
                            <a id="lnkStudentFinancialTotals" runat="server" class=""></a>
                        </li>

                        <li id="liStudentFinancialStatement" runat="server">
                            <a href='<%= GetStageUrl("Reports/StudentFinancialStatement.aspx") %>'
                               class='<%= GetActiveClass("StudentFinancialStatement") %>'>
                                <i class="fas fa-file-invoice-dollar"></i>
                                الكشف المالي للطلاب
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- =========================================== -->
                <!-- 7) إدارة النظام -->
                <!-- =========================================== -->
                <li id="navSystem" runat="server"
                    class='nav-item has-flyout <%= GetSectionActiveClass("Users","BackupRestore","AuditLog") %>'>
                    <a href="javascript:void(0);" class="nav-link-parent">
                        <i class="nav-icon fas fa-cog"></i>
                        <span>إدارة النظام</span>
                        <i class="nav-chevron fas fa-chevron-left"></i>
                    </a>
                    <ul class="nav-flyout">
                        <li>
                            <a href='<%= GetStageUrl("Security/Users.aspx") %>'
                               class='<%= GetActiveClass("Users") %>'>
                                <i class="fas fa-users-cog"></i>
                                إدارة المستخدمين والصلاحيات
                            </a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("~/Pages/Database/BackupRestore.aspx") %>'
                               class='<%= GetActiveClass("BackupRestore") %>'>
                                <i class="fas fa-database"></i>
                                نسخ قاعدة البيانات واستعادتها
                            </a>
                        </li>
                        <li>
                            <a href='<%= GetStageUrl("Security/AuditLog.aspx") %>'
                               class='<%= GetActiveClass("AuditLog") %>'>
                                <i class="fas fa-history"></i>
                                سجل تدقيق النظام
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>

        </nav>

    </aside>

    <div class="sidebar-overlay no-print"
         id="sidebarOverlay"
         aria-hidden="true"></div>


    <!-- ===================================================== -->
    <!-- Main Content -->
    <!-- ===================================================== -->

    <div class="main-content">

        <header class="top-header">

            <div class="header-main">

                <button type="button"
                        class="sidebar-toggle no-print"
                        id="sidebarToggle"
                        aria-label="فتح القائمة الجانبية"
                        aria-controls="sidebar"
                        aria-expanded="false">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="page-title-area">

                    <h5 id="pageTitle"
                        runat="server">

                        لوحة التحكم

                    </h5>

                </div>

            </div>


            <div class="header-actions">

                <button type="button"
                        class="header-icon-btn no-print"
                        onclick="window.print()"
                        title="طباعة">
                    <i class="fas fa-print"></i>
                </button>

                <div class="header-icon-btn"
                     style="cursor:default;">
                    <i class="fas fa-bell"></i>
                    <span class="badge-dot"></span>
                </div>

                <div class="user-avatar"
                     title=""
                     style="cursor:default;">
                    <asp:Literal ID="litUserInitial" runat="server" />
                </div>

                <span style="font-size:13px;font-weight:600;color:var(--text-secondary);"
                      class="no-print">
                    <asp:Literal ID="litDisplayName" runat="server" />
                </span>

                <asp:LinkButton ID="btnLogout"
                    runat="server"
                    OnClick="btnLogout_Click"
                    CssClass="no-print"
                    style="border:none;background:none;color:#dc2626;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;">
                    <i class="fas fa-sign-out-alt"></i>
                    خروج
                </asp:LinkButton>

            </div>

        </header>


        <div class="content-wrapper">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>


        <footer class="footer">

            <span class="school-name">
                مدرسة نور الملائكة
            </span>

            &copy;
            <%= DateTime.Now.Year %>
            — جميع الحقوق محفوظة

        </footer>

    </div>

</form>


<script src="<%= ResolveUrl("~/Content/js/bootstrap.bundle.min.js") %>"></script>

<script src="<%= ResolveUrl("~/Content/js/site-master.js") %>"></script>

<asp:ContentPlaceHolder ID="Scripts" runat="server" />


</body>

</html>
