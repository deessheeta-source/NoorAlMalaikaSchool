<?xml version="1.0"?>
<configuration>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
		<add key="DatabaseBackupPath" value="~/App_Data/DatabaseBackups"/>
	</appSettings>
	<connectionStrings>
		<add name="DefaultConnection" connectionString="Server=SHEETAGECOL\SQLSERVER2026;Database=NoorAlMalaikaSchool;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<!-- debug="false" is the safe default: it stops recompiling the whole site on every
		     request, removes internal type/method names from error output, and prevents the
		     20-minute CPU limit from recycling the worker process. Web.Debug.config relaxes
		     this back to true for local debugging only. -->
		<compilation debug="false" targetFramework="4.8">
			<assemblies>
				<add assembly="System.Web.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
			</assemblies>
		</compilation>
		<!-- machineKey pins the key that protects three things: the forms-authentication
		     ticket cookie, ViewState/MachineKey-protected data, and any encrypted values
		     the app stores. Without an explicit key, ASP.NET generates one per
		     application instance, so every app-pool recycle or every move to another
		     server invalidates all live sessions and silently breaks postbacks that
		     carry protected state.
		     OPERATIONAL RULES - do not skip these:
		       1. Every instance serving the same site MUST use an identical key, or users
		          will bounce between logins.
		       2. Rotating the key signs every user out and invalidates existing protected
		          state. Do it deliberately, outside working hours.
		       3. The value below is generated and unique to this installation. Treat the
		          repository as a secret: anyone holding this file can forge a forms-auth
		          ticket. If the repository is ever shared beyond the team, generate a
		          different key per environment and keep the production one out of git. -->
		<!-- Key sizes are NOT free-form; ASP.NET requires an exact length for each algorithm
		     and throws CryptographicException from ObjectStateFormatter.Serialize (i.e. a blank
		     page) if the length is wrong. HMACSHA256 needs a 64-byte validationKey, AES needs a
		     16/24/32-byte decryptionKey. Do not pad, truncate or "tidy" these lengths. -->
		<machineKey validationKey="bf899cfd11fbb1d083e4751fd1fba737da76522778c7f95e8c9473d166d98739a934d58e8ca9ec1182db9d53ce8e08853685034f91a5e87d99a897c67d6ff00d"
		            decryptionKey="1cd301473638c503f367ddd911fb959b1cd0e28e1536c52ce90660b380eaa682"
		            validation="HMACSHA256" decryption="AES" />
		<httpRuntime targetFramework="4.8" maxRequestLength="5120" executionTimeout="120" requestValidationMode="4.5"/>
		<!-- requireSSL is intentionally false ONLY while the site is served over plain HTTP
		     (for example http://localhost:8080). Setting it to true on an HTTP site breaks
		     login completely because the forms-auth ticket is then never sent back.
		     Web.Release.config flips BOTH values to true on publish, so any real deployment
		     gets HTTPS-only cookies. Do not remove that transform. -->
		<httpCookies httpOnlyCookies="true" requireSSL="false"/>
		<authentication mode="Forms">
			<forms loginUrl="~/Login.aspx" timeout="60" defaultUrl="~/Default.aspx" requireSSL="false" slidingExpiration="true"/>
		</authentication>
		<authorization>
			<deny users="?"/>
		</authorization>
		<pages clientIDMode="AutoID">
			<namespaces/>
		</pages>
		<!-- Errors are shown to the user as a generic page. Full details are still written to
		     ~/App_Data/app-errors.log and ~/App_Data/Logs/application-*.log by Global.asax.cs
		     and Services/AppErrorLogger.cs, so problems stay diagnosable. -->
		<customErrors mode="On" defaultRedirect="~/Error.aspx" />
		<globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
	</system.web>

	<!-- ============================================================
       Anonymous access exceptions
       ============================================================ -->

	<!-- Login page must be accessible to anonymous users -->
	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- ✅ Allow anonymous access to ALL static content (images, css, js, fonts) -->
	<location path="Content">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- ✅ Allow anonymous access to Scripts (in case you have JS files) -->
	<location path="Scripts">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- ✅ Allow anonymous access to favicon and robots -->
	<location path="favicon.ico">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>

	<!-- ============================================================ -->

	<system.webServer>
		<!-- Custom (not DetailedLocalOnly) so IIS never returns a detailed error document,
		     not even to local callers. -->
		<httpErrors errorMode="Custom" existingResponse="PassThrough"/>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
			<remove name="OPTIONSVerbHandler"/>
			<remove name="TRACEVerbHandler"/>
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
		</handlers>
		<defaultDocument>
			<files>
				<clear/>
				<add value="Default.aspx"/>
			</files>
		</defaultDocument>
	</system.webServer>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Azure.Core" publicKeyToken="92742159e12e44c8" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-1.50.0.0" newVersion="1.50.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.3" newVersion="8.0.0.3"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Identity.Client" publicKeyToken="0a613f4dd989e8ae" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.80.0.0" newVersion="4.80.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.IdentityModel.Abstractions" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.14.0.0" newVersion="8.14.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory.Data" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Security.AccessControl" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.6" newVersion="8.0.0.6"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
