# ===========================================================================
#  NoorAlMalaikaSchool - Git ignore rules
#  Tuned for an ASP.NET WebForms (.NET Framework 4.8) project using NuGet.
# ===========================================================================

# ---- Visual Studio ---------------------------------------------------------
.vs/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
.vscode/
_ReSharper*/
*.ReSharper
*.ReSharper.user
*.DotSettings

# NOTE: *.designer.cs files are intentionally NOT ignored.
# This is a WebForms project and those .designer.cs files are compiled
# (they appear as <Compile Include="...designer.cs"> in the .csproj).
# Ignoring them would break the build for every other developer.

# ---- Build output ----------------------------------------------------------
[Bb]uild/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rtifacts/
*.dll.config
*.pdb
*.cache
*.ilk
*.obj
*.pch
*.idb
*.tlog
*.lastbuildstate
*.hpj
*.suo

# ---- NuGet -----------------------------------------------------------------
# packages/ is restored from packages.config + the NuGet feed.
packages/
!packages/build/
.nuget/
*.nupkg
*.snupkg

# ---- Runtime logs & local data --------------------------------------------
# App_Data holds only runtime log output, not data we need to version.
App_Data/*.log
App_Data/Logs/
App_Data/DatabaseBackups/
App_Data/*.mdf
App_Data/*.ldf
*.log

# Local SQL backup files should never be committed.
*.bak
*.bacpac
*.trn
*.bak.*
*.trn.*

# ---- Secrets / machine-specific config -------------------------------------
# These differ per machine/developer and can contain credentials.
*.pfx
*.p12
*.snk
*.key
*.pem
*.mdf
*.ldf
*.publishsettings
*.pubxml.user
*.publishsettings
publishprofiles/
**/App.config.local
.env
.env.*

# ---- OS noise --------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
*.tmp
*.bak~

# ---- Production secrets (machineKey, connection strings) -------------------
# Web.Release.config يحتوي على مفاتيح التشفير الخاصة بالإنتاج.
# يجب الاحتفاظ بنسخة محلية فقط، وليس رفعه إلى الـ repository.
# استخدم Web.Release.config.example كقالب للبيئات الجديدة.
Web.Release.config
